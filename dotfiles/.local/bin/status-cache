#!/bin/bash
# status-cache — prints Tailscale device + service status as shell variable
# assignments. Always returns instantly from cache; refreshes in background.
#
# Usage: eval "$(status-cache)"
#
# Variables: ts_spa1lnx ts_pixel ts_himbeere ts_sadeniemi ts_stratoserver
#             svc_tausendsassa svc_roaringbot svc_website svc_nextcloud
# All values: 1 = online/available, 0 = offline/unavailable.

TS_CACHE="/tmp/ts-status-$(whoami)"
SVC_CACHE="/tmp/svc-status-$(whoami)"
TS_MAX_AGE=30
SVC_MAX_AGE=60

# ── Ensure cache files exist (create with defaults on first run) ──────────
_init_defaults() {
  if [ ! -f "$TS_CACHE" ]; then
    for v in ts_spa1lnx ts_pixel ts_himbeere ts_sadeniemi ts_stratoserver; do
      echo "${v}=0"
    done > "$TS_CACHE"
  fi
  if [ ! -f "$SVC_CACHE" ]; then
    for v in svc_tausendsassa svc_roaringbot svc_website svc_nextcloud; do
      echo "${v}=0"
    done > "$SVC_CACHE"
  fi
}

# ── Tailscale refresh ─────────────────────────────────────────────────────
declare -A TS_MAP=(
  [spa1lnx]=ts_spa1lnx
  [pixel-7a-von-spa1ten]=ts_pixel
  [himbeere]=ts_himbeere
  [sadeniemi]=ts_sadeniemi
  [stratoserver]=ts_stratoserver
)

_refresh_ts() {
  declare -A results
  for v in "${TS_MAP[@]}"; do results[$v]=0; done

  while IFS= read -r line; do
    local host=$(echo "$line" | awk '{print $2}')
    local rest=$(echo "$line" | awk '{for(i=5;i<=NF;i++) printf "%s ", $i; print ""}')
    [ -z "$host" ] && continue
    local var="${TS_MAP[$host]:-}"
    [ -z "$var" ] && continue
    if ! echo "$rest" | grep -qi "offline"; then
      results[$var]=1
    fi
  done < <(tailscale status 2>/dev/null)

  local self
  self=$(tailscale status --json 2>/dev/null | python3 -c "
import sys,json
try:
    d=json.load(sys.stdin)
    print(d.get('Self',{}).get('HostName',''))
except: pass
" 2>/dev/null)
  local self_var="${TS_MAP[$self]:-}"
  [ -n "$self_var" ] && results[$self_var]=1

  for v in "${TS_MAP[@]}"; do
    echo "${v}=${results[$v]}"
  done > "$TS_CACHE"
}

# ── Service refresh ──────────────────────────────────────────────────────
_refresh_svc() {
  # Ensure DASHBOARD_AUTH is available (background nohup may not have it)
  [ -z "${DASHBOARD_AUTH:-}" ] && [ -f ~/.bash_aliases ] && source ~/.bash_aliases 2>/dev/null
  local auth_b64=""
  [ -n "${DASHBOARD_AUTH:-}" ] && auth_b64=$(printf '%s' "$DASHBOARD_AUTH" | base64 -w0)

  # Collect all results in an associative array, write once at the end
  declare -A results
  for svc in tausendsassa roaringbot website nextcloud; do
    results[$svc]=0
  done

  for svc in roaringbot tausendsassa; do
    resp=$(curl -sf --connect-timeout 2 --max-time 3 \
      "https://casparsadenius.de/about/api/status/${svc}/" 2>/dev/null) || continue
    avail=$(echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print(1 if d.get('available') else 0)" 2>/dev/null) || continue
    [ "$avail" = "1" ] && results[$svc]=1
  done

  if [ -n "$auth_b64" ]; then
    for svc in website nextcloud; do
      resp=$(curl -sf --connect-timeout 2 --max-time 3 \
        -H "Authorization: Basic $auth_b64" \
        "https://dashboard.casparsadenius.de/api/${svc}/status" 2>/dev/null) || continue
      avail=$(echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print(1 if d.get('available') else 0)" 2>/dev/null) || continue
      [ "$avail" = "1" ] && results[$svc]=1
    done
  fi

  # Write all results at once
  for svc in tausendsassa roaringbot website nextcloud; do
    echo "svc_${svc}=${results[$svc]}"
  done > "$SVC_CACHE"
}

# Internal refresh-only mode (spawned via nohup from main output below)
if [ "${1:-}" = "--refresh-ts" ]; then
  _refresh_ts
  exit 0
elif [ "${1:-}" = "--refresh-svc" ]; then
  _refresh_svc
  exit 0
fi

# ── Main: output cache instantly, trigger background refresh if stale ─────
_now=$(date +%s)

# Determine staleness BEFORE creating defaults (otherwise defaults make
# the cache look fresh and refresh never triggers)
_stale_ts=0
if [ ! -f "$TS_CACHE" ] || [ "$(( _now - $(stat -c%Y "$TS_CACHE" 2>/dev/null || echo 0) ))" -gt "$TS_MAX_AGE" ]; then
  _stale_ts=1
fi

_stale_svc=0
if [ ! -f "$SVC_CACHE" ] || [ "$(( _now - $(stat -c%Y "$SVC_CACHE" 2>/dev/null || echo 0) ))" -gt "$SVC_MAX_AGE" ]; then
  _stale_svc=1
fi

# Create defaults only if cache is missing (background refresh will populate)
_init_defaults

# Output current cache immediately
[ -f "$TS_CACHE" ]  && cat "$TS_CACHE"
[ -f "$SVC_CACHE" ] && cat "$SVC_CACHE"

# Trigger background refresh if stale. Use nohup to survive script exit,
# and run via a separate bash invocation so functions resolve properly.
if [ "$_stale_ts" = "1" ]; then
  nohup bash "$0" --refresh-ts >/dev/null 2>&1 &
fi
if [ "$_stale_svc" = "1" ]; then
  nohup bash "$0" --refresh-svc >/dev/null 2>&1 &
fi
